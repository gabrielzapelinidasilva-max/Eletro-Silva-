# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase → Project Settings → API

# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" / "publishable" (pode ir para o navegador; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# OPCIONAL. Chave SECRETA "service_role" / "secret", usada só no servidor para gerenciar colaboradores.
# Sem ela, o app usa as funções admin_* do banco (migração 0004).
# NUNCA coloque NEXT_PUBLIC_ na frente dela e nunca a compartilhe.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
